    {
        "id": "4384e1d06939519a",
        "type": "function",
        "z": "34a438ba0fa6a764",
        "name": "function 11",
        "func": "// Use the nullish coalescing operator (??) or check specifically for undefined\nlet va = global.get(\"va_rms\");\nlet vb = global.get(\"vb_rms\");\nlet vc = global.get(\"vc_rms\");\n\nlet ia = global.get(\"ia_rms\");\nlet ib = global.get(\"ib_rms\");\nlet ic = global.get(\"ic_rms\");\n\n// If the value is strictly undefined (not set yet), then use default. \n// If it is 0, it will keep 0.\nva = (typeof va !== 'undefined') ? va : 110000;\nvb = (typeof vb !== 'undefined') ? vb : 110000;\nvc = (typeof vc !== 'undefined') ? vc : 110000;\n\n\nia = (typeof ia !== 'undefined') ? ia : 1;\nib = (typeof ib !== 'undefined') ? ib : 1;\nic = (typeof ic !== 'undefined') ? ic : 1;\n\nlet msgA = { payload: va, topic: \"sv/va/rms\" };\nlet msgB = { payload: vb, topic: \"sv/vb/rms\" };\nlet msgC = { payload: vc, topic: \"sv/vc/rms\" };\n\nlet msgD = { payload: ia, topic: \"sv/ia/rms\" };\nlet msgE = { payload: ib, topic: \"sv/ib/rms\" };\nlet msgF = { payload: ic, topic: \"sv/ic/rms\" };\n\nreturn [[msgA, msgB, msgC, msgD, msgE, msgF] ];",
