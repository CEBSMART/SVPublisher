    {
        "id": "e95f807f6b403a7f",
        "type": "function",
        "z": "34a438ba0fa6a764",
        "name": "function 17",
        "func": "let results = [];\n\n// Recursive search for all SampledValueControl tags\nfunction findSV(obj) {\n    for (let key in obj) {\n        if (key === 'SampledValueControl') {\n            let controls = Array.isArray(obj[key]) ? obj[key] : [obj[key]];\n            \n            controls.forEach(sv => {\n                let cleanObj = {};\n\n                // 1. Extract all XML Attributes (name, datSet, smvID, etc.)\n                if (sv.$) {\n                    Object.assign(cleanObj, sv.$);\n                }\n\n                // 2. Extract Child Elements (IEDName, SmvOpts, etc.)\n                for (let prop in sv) {\n                    if (prop === '$') continue; // Skip attributes we already got\n                    \n                    let val = sv[prop];\n                    \n                    // If it's a simple text array like [\"Value\"], flatten it\n                    if (Array.isArray(val) && val.length === 1 && typeof val[0] === 'string') {\n                        cleanObj[prop] = val[0];\n                    } \n                    // If it's an object with attributes (like SmvOpts), grab them\n                    else if (Array.isArray(val) && val[0] && val[0].$) {\n                        cleanObj[prop] = val[0].$;\n                    }\n                    else {\n                        cleanObj[prop] = val;\n                    }\n                }\n                results.push(cleanObj);\n            });\n        } else if (typeof obj[key] === 'object' && obj[key] !== null) {\n            findSV(obj[key]);\n        }\n    }\n}\n\nfindSV(msg.payload);\nmsg.payload = results;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 1380,
        "wires": [
            [
                "c39596c2118fd2fa",
                "642eb79c18d890f9"
            ]
        ]
    },
    {
        "id": "a233664509ed9d6b",
        "type": "function",
        "z": "34a438ba0fa6a764",
        "name": "function 18",
        "func": "// 1. Get current buffer\nlet fileContent = context.get('fileContent') || \"\";\n\n// 2. Check the length\nlet currentLength = fileContent.length;\n\n// 3. Log it to the Debug sidebar so you can watch it grow with each chunk\n//node.warn(\"Current buffer size: \" + currentLength + \" characters\");\n\n// 2. Identify where the message came from\n// If it has a payload and it's a chunk of data:\nif (msg.topic !== \"RELEASE_FILE\") {\n    fileContent += msg.payload.toString();\n    context.set('fileContent', fileContent);\n    \n\n\n    // If the Global is already 1, we can proceed, \n    // otherwise wait for the next chunk or the manual trigger.\n    if (global.get('upload_complete') !== 1) {\n        return null; \n    }\n}\n\n// 3. If we are here, either the Global just hit 1 \n// OR a manual \"Done\" message arrived (topic: TRIGGER_DONE)\nmsg.payload = fileContent;\n\n// 4. Cleanup\ncontext.set('fileContent', \"\");\nglobal.set('upload_complete', 0);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
